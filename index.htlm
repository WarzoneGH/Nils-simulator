import pygame
import sys
import random
import math

# Initialisera Pygame
pygame.init()

# Skärminställningar
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Nils Simulator")

# Färger
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
BLUE = (50, 150, 255)      # Nils färg
RED = (255, 50, 50)        # Folkets färg
GRAY = (120, 120, 120)      # Pennans färg
YELLOW = (255, 220, 100)    # Pennspetsen
GREEN = (50, 200, 50)       # UI-text

# Klocka för FPS
clock = pygame.time.Clock()
FPS = 60

# Spelare (Nils) inställningar
player_pos = [SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2]
player_radius = 25
player_speed = 5

# Penna inställningar
pen_length = 40
pen_width = 8
is_stabbing = False
stab_progress = 0
stab_speed = 0.2  # Hur snabbt hugget animeras

# Poäng och Fiender (Folk)
score = 0
enemies = []
enemy_radius = 20
enemy_spawn_timer = 0

def spawn_enemy():
    """Skapar en ny person på ett slumpmässigt ställe utanför skärmen eller en bit bort"""
    x = random.randint(enemy_radius, SCREEN_WIDTH - enemy_radius)
    y = random.randint(enemy_radius, SCREEN_HEIGHT - enemy_radius)
    # Se till att de inte spawnar direkt på spelaren
    while math.hypot(x - player_pos[0], y - player_pos[1]) < 150:
        x = random.randint(enemy_radius, SCREEN_WIDTH - enemy_radius)
        y = random.randint(enemy_radius, SCREEN_HEIGHT - enemy_radius)
    enemies.append([x, y])

# Spelloop
running = True
while running:
    screen.fill(WHITE)
    
    # Hantera event
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        elif event.type == pygame.MOUSEBUTTONDOWN:
            if event.button == 1 and not is_stabbing:  # Vänsterklick för att hugga
                is_stabbing = True
                stab_progress = 0.0

    # Rörelse för Nils (WASD eller Piltangenter)
    keys = pygame.key.get_pressed()
    if keys[pygame.K_a] or keys[pygame.K_LEFT]:
        player_pos[0] -= player_speed
    if keys[pygame.K_d] or keys[pygame.K_RIGHT]:
        player_pos[0] += player_speed
    if keys[pygame.K_w] or keys[pygame.K_UP]:
        player_pos[1] -= player_speed
    if keys[pygame.K_s] or keys[pygame.K_DOWN]:
        player_pos[1] += player_speed

    # Håll Nils inom skärmens gränser
    player_pos[0] = max(player_radius, min(SCREEN_WIDTH - player_radius, player_pos[0]))
    player_pos[1] = max(player_radius, min(SCREEN_HEIGHT - player_radius, player_pos[1]))

    # Räkna ut vinkel mot muspekaren för pennan
    mouse_x, mouse_y = pygame.mouse.get_pos()
    angle = math.atan2(mouse_y - player_pos[1], mouse_x - player_pos[0])

    # Hantera hugg-animation och logik
    current_pen_length = pen_length
    if is_stabbing:
        stab_progress += stab_speed
        # Skapar en fram-och-tillbaka effekt för hugget
        current_pen_length += math.sin(stab_progress * math.pi) * 30 
        if stab_progress >= 1.0:
            is_stabbing = False

    # Beräkna pennspetsens position (för kollisionsdetektion)
    pen_tip_x = player_pos[0] + math.cos(angle) * (player_radius + current_pen_length)
    pen_tip_y = player_pos[1] + math.sin(angle) * (player_radius + current_pen_length)

    # Spawnar folk automatiskt över tid
    enemy_spawn_timer += 1
    if enemy_spawn_timer > 60 and len(enemies) < 10:  # Max 10 personer samtidigt
        spawn_enemy()
        enemy_spawn_timer = 0

    # Kolla om pennan träffar folket under ett hugg
    if is_stabbing:
        for enemy in enemies[:]:
            distance_to_tip = math.hypot(enemy[0] - pen_tip_x, enemy[1] - pen_tip_y)
            if distance_to_tip <= enemy_radius:
                enemies.remove(enemy)
                score += 1

    # Rita folket
    for enemy in enemies:
        pygame.draw.circle(screen, RED, (enemy[0], enemy[1]), enemy_radius)
        # Rita enkla ögon på folket
        pygame.draw.circle(screen, BLACK, (enemy[0] - 5, enemy[1] - 5), 2)
        pygame.draw.circle(screen, BLACK, (enemy[0] + 5, enemy[1] - 5), 2)

    # Rita Nils (Spelaren)
    pygame.draw.circle(screen, BLUE, (player_pos[0], player_pos[1]), player_radius)
    
    # Rita Nils ögon som tittar mot muspekaren
    eye_offset_x = math.cos(angle) * 8
    eye_offset_y = math.sin(angle) * 8
    pygame.draw.circle(screen, BLACK, (int(player_pos[0] + eye_offset_x - 5), int(player_pos[1] + eye_offset_y)), 3)
    pygame.draw.circle(screen, BLACK, (int(player_pos[0] + eye_offset_x + 5), int(player_pos[1] + eye_offset_y)), 3)

    # Rita pennan (som ett streck/rektangel ut från Nils)
    pen_base_x = player_pos[0] + math.cos(angle) * player_radius
    pen_base_y = player_pos[1] + math.sin(angle) * player_radius
    pygame.draw.line(screen, GRAY, (pen_base_x, pen_base_y), (pen_tip_x, pen_tip_y), pen_width)
    pygame.draw.circle(screen, YELLOW, (int(pen_tip_x), int(pen_tip_y)), 3)  # Pennspets

    # UI - Visa poäng
    font = pygame.font.SysFont("Arial", 30)
    score_text = font.render(f"Hugget folk: {score}", True, BLACK)
    screen.blit(score_text, (20, 20))

    # Uppdatera skärmen
    pygame.display.flip()
    clock.tick(FPS)

pygame.quit()
sys.exit()
