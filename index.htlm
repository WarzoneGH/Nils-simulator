import pygame, sys, math, random

pygame.init()
W, H = 800, 600
screen = pygame.display.set_mode((W, H))
pygame.display.set_caption("Nils Mario Simulator")
clock = pygame.time.Clock()

class Platform:
    def __init__(self, x, y, w, h): self.rect = pygame.Rect(x, y, w, h)
    def draw(self, surf, cam_x):
        pygame.draw.rect(surf, (0,168,0), (self.rect.x - cam_x, self.rect.y, self.rect.w, self.rect.h))
        pygame.draw.rect(surf, (0,0,0), (self.rect.x - cam_x, self.rect.y, self.rect.w, self.rect.h), 2)

class Stefan:
    def __init__(self, x, y):
        self.x, self.y, self.w, self.h = x, y, 30, 40
        self.speed, self.dir, self.hp, self.max_hp = 2, 1, 3, 3
        self.rect = pygame.Rect(x, y, self.w, self.h)
    def update(self, plats):
        self.x += self.speed * self.dir
        self.rect.x = self.x
        if self.x < 100 or self.x > 2000: self.dir *= -1
        self.y += 4
        self.rect.y = self.y
        for p in plats:
            if self.rect.colliderect(p.rect) and self.y + self.h - 4 <= p.rect.top:
                self.y = p.rect.top - self.h
                self.rect.y = self.y
    def draw(self, surf, cam_x):
        dx = self.x - cam_x
        pygame.draw.rect(surf, (255,100,100), (dx, self.y + 15, self.w, self.h - 15))
        pygame.draw.circle(surf, (168,68,0), (int(dx + self.w//2), int(self.y + 10)), 12)
        pygame.draw.circle(surf, (0,0,0), (int(dx + self.w//2 - 4), int(self.y + 8)), 2)
        pygame.draw.circle(surf, (0,0,0), (int(dx + self.w//2 + 4), int(self.y + 8)), 2)
        pygame.draw.rect(surf, (0,0,0), (dx, self.y - 12, 30, 6))
        pygame.draw.rect(surf, (255,0,0), (dx, self.y - 12, int((30/self.max_hp)*self.hp), 6))

class NilsPlayer:
    def __init__(self):
        self.x, self.y, self.w, self.h = 200, 300, 30, 50
        self.vx, self.vy, self.speed, self.jump = 0, 0, 5, -13
        self.grounded, self.right = False, True
        self.rect = pygame.Rect(self.x, self.y, self.w, self.h)
        self.stab, self.progress, self.stab_spd, self.length = False, 0.0, 0.2, 35
    def move(self, keys, plats):
        self.vx = 0
        if keys[pygame.K_a] or keys[pygame.K_LEFT]: self.vx, self.right = -self.speed, False
        if keys[pygame.K_d] or keys[pygame.K_RIGHT]: self.vx, self.right = self.speed, True
        if (keys[pygame.K_w] or keys[pygame.K_SPACE]) and self.grounded: self.vy, self.grounded = self.jump, False
        self.vy += 0.6
        self.x += self.vx
        self.rect.x = self.x
        for p in plats:
            if self.rect.colliderect(p.rect):
                if self.vx > 0: self.rect.right = p.rect.left
                elif self.vx < 0: self.rect.left = p.rect.right
                self.x = self.rect.x
        self.y += self.vy
        self.rect.y = self.y
        self.grounded = False
        for p in plats:
            if self.rect.colliderect(p.rect):
                if self.vy > 0: self.rect.bottom, self.vy, self.grounded = p.rect.top, 0, True
                elif self.vy < 0: self.rect.top, self.vy = p.rect.bottom, 0
                self.y = self.rect.y
        if self.y > H: self.x, self.y, self.vy = 200, 300, 0
    def attack(self, enemies):
        cur_len = self.length
        if self.stab:
            self.progress += self.stab_spd
            cur_len += math.sin(self.progress * math.pi) * 25
            if self.progress >= 1.0: self.stab = False
        cy = self.y + self.h // 2
        tip_x = self.x + self.w + cur_len if self.right else self.x - cur_len
        if self.stab and self.progress <= self.stab_spd * 1.5:
            for e in enemies[:]:
                hr = pygame.Rect(min(self.x + self.w, tip_x) if self.right else tip_x, cy - 5, cur_len, 10)
                if hr.colliderect(e.rect):
                    e.hp -= 1
                    self.stab = False
                    if e.hp <= 0: enemies.remove(e)
                    break
    def draw(self, surf, cam_x):
        dx = self.x - cam_x
        pygame.draw.rect(surf, (0,0,180), (dx, self.y + 25, self.w, 25))
        pygame.draw.rect(surf, (228,0,0), (dx, self.y + 10, self.w, 15))
        pygame.draw.circle(surf, (255,200,150), (int(dx + self.w//2), int(self.y + 5)), 10)
        pygame.draw.rect(surf, (228,0,0), (dx + 2, self.y - 8, self.w - 4, 6))
        ex = dx + (self.w // 2 + 4 if self.right else self.w // 2 - 6)
        pygame.draw.circle(surf, (0,0,0), (int(ex), int(self.y + 3)), 2)
        cy = self.y + self.h // 2 + 5
        cur_len = self.length + (math.sin(self.progress * math.pi) * 25 if self.stab else 0)
        bx = dx + self.w if self.right else dx
        tx = bx + cur_len if self.right else bx - cur_len
        pygame.draw.line(surf, (120,70,30), (bx, cy), (tx, cy), 6)
        pygame.draw.circle(surf, (0,0,0), (int(tx), int(cy)), 3)

player = NilsPlayer()
platforms = [Platform(0, 520, 1200, 80), Platform(1400, 520, 1000, 80), Platform(300, 400, 150, 30), Platform(550, 320, 200, 30), Platform(850, 400, 150, 30), Platform(1550, 400, 250, 30)]
stefans = [Stefan(400, 450), Stefan(600, 250), Stefan(1000, 450), Stefan(1600, 350)]
cam_x = 0

while True:
    screen.fill((107, 140, 255))
    for event in pygame.event.get():
        if event.type == pygame.QUIT: pygame.quit(); sys.exit()
        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1 and not player.stab: player.stab, player.progress = True, 0.0
    
    player.move(pygame.key.get_pressed(), platforms)
    player.attack(stefans)
    for s in stefans: s.update(platforms)
    
    if player.x - cam_x > 500: cam_x = player.x - 500
    elif player.x - cam_x < 200: cam_x = max(0, player.x - 200)
    
    for p in platforms: p.draw(screen, cam_x)
    for s in stefans: s.draw(screen, cam_x)
    player.draw(screen, cam_x)
    
    font = pygame.font.SysFont("Arial", 22)
    screen.blit(font.render("Styr: A/D/Pilar | Hoppa: W/Space | Hugg: Vänsterklick", True, (255,255,255)), (20, 20))
    screen.blit(font.render(f"Stefans kvar: {len(stefans)}", True, (255,255,255)), (20, 45))
    
    pygame.display.flip()
    clock.tick(60)
